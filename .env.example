TRIBE_HOST=0.0.0.0
TRIBE_PORT=8000
TRIBE_FORCE_CPU=true
TRIBE_CACHE_DIR=/cache
TRIBE_JOBS_DIR=/jobs
TRIBE_MAX_TEXT_CHARS=5000
TRIBE_MAX_PENDING_JOBS=3
TRIBE_RESULT_TTL_HOURS=24
TRIBE_DELETE_INPUTS_AFTER_JOB=true
TRIBE_KEEP_FAILED_INPUTS=false
TRIBE_DEBUG_ARTIFACTS=false
TRIBE_FAKE_INFERENCE=false
TRIBE_ENABLE_TEXT_EVENTS=false
TRIBE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
